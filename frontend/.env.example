# ─────────────────────────────────────────────────────────────────────────────
# FabriSense Frontend (Vite) Environment Configuration
# Copy this file to .env inside frontend/ and customize as needed
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend API Base URL ────────────────────────────────────────────────────
# Controls which backend URL the frontend connects to:
#
# ┌──────────────────────────────┬────────────────────────────────────────────┐
# │ Environment                  │ VITE_API_BASE_URL value                    │
# ├──────────────────────────────┼────────────────────────────────────────────┤
# │ Browser Dev (npm run dev)    │ (leave empty) — Vite proxy forwards /api   │
# │ Android Emulator             │ http://10.0.2.2:5000                       │
# │ Android Physical Device(LAN) │ http://192.168.x.x:5000 (your machine IP)  │
# │ Production / Deployed        │ https://api.yourdomain.com                 │
# └──────────────────────────────┴────────────────────────────────────────────┘
#
VITE_API_BASE_URL=
