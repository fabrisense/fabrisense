# ─────────────────────────────────────────────────────────────────────────────
# FabriSense Backend Environment Configuration
# Copy this file to .env inside backend/ (or root) and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── Server Port ──────────────────────────────────────────────────────────────
PORT=5000

# ── Node Environment ─────────────────────────────────────────────────────────
NODE_ENV=development

# ── CORS: Allowed frontend origins ───────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── Authentication / Security ────────────────────────────────────────────────
JWT_SECRET=fabrisense_super_secret_jwt_key_2024_textile_ai_inspection
JWT_EXPIRES_IN=7d

# ── Database Storage ─────────────────────────────────────────────────────────
DATABASE_PATH=./database/fabrisense.db

# ── AI / YOLOv8 Configuration ────────────────────────────────────────────────
# Set AI_MODE to 'mock' for prototype/demo engine or 'yolo' for production
AI_MODE=mock
# URL of external YOLOv8 inference server (used when AI_MODE=yolo)
YOLO_API_URL=http://localhost:8000/predict

# ── Local File Uploads Directory ─────────────────────────────────────────────
UPLOADS_DIR=./uploads/inspections

# ── Email / SMTP Configuration ───────────────────────────────────────────────
# When omitted or blank, OTP codes are logged directly to the server terminal.
# To send real emails via Gmail:
#   1. Enable 2-Step Verification on your Google Account
#   2. Create an App Password at https://myaccount.google.com/apppasswords
#   3. Paste the 16-character App Password in SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="FabriSense Security" <your_email@gmail.com>

# Alternative EMAIL_* variable names are also supported:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_16_character_app_password
# EMAIL_FROM="FabriSense Security" <your_email@gmail.com>

# ── Supabase Cloud Database & Storage Configuration ──────────────────────────
# Copy Project URL, Anon Key, and Service Role Key from your Supabase Dashboard
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=inspection-images

