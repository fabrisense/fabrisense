# ─────────────────────────────────────────────────────────────────────────────
# FabriSense Backend Environment Configuration
# Copy this file to .env inside backend/ (or root) and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── Server Port ──────────────────────────────────────────────────────────────
PORT=5000

# ── Node Environment ─────────────────────────────────────────────────────────
NODE_ENV=development

# ── CORS: Allowed frontend origins ───────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── Email / SMTP Configuration ───────────────────────────────────────────────
# When omitted or blank, OTP codes are logged directly to the server terminal.
# To send real emails via Gmail:
#   1. Enable 2-Step Verification on your Google Account
#   2. Create an App Password at https://myaccount.google.com/apppasswords
#   3. Paste the 16-character App Password in SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="FabriSense Security" <your_email@gmail.com>

# Alternative EMAIL_* variable names are also supported:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_16_character_app_password
# EMAIL_FROM="FabriSense Security" <your_email@gmail.com>
