# ─────────────────────────────────────────────────────────────────────────────
# FabriSense Environment Configuration — copy this file to .env and fill in values
# NEVER commit .env to git (it is already in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend server port ───────────────────────────────────────────────────────
PORT=5000

# ── Node Environment ─────────────────────────────────────────────────────────
NODE_ENV=development

# ── CORS: comma-separated allowed frontend origins ────────────────────────────
# For browser dev only. The Vite dev server at port 5173 is already included.
CLIENT_ORIGIN=http://localhost:5173

# ── Authentication / Security ────────────────────────────────────────────────
JWT_SECRET=fabrisense_super_secret_jwt_key_2024_textile_ai_inspection
JWT_EXPIRES_IN=7d

# ── Database Storage ─────────────────────────────────────────────────────────
DATABASE_PATH=backend/database/fabrisense.db

# ── AI / YOLOv8 Configuration ────────────────────────────────────────────────
# Set AI_MODE to 'mock' for prototype/demo engine or 'yolo' for production
AI_MODE=mock
# URL of external YOLOv8 inference server (used when AI_MODE=yolo)
YOLO_API_URL=http://localhost:8000/predict

# ── Local File Uploads Directory ─────────────────────────────────────────────
UPLOADS_DIR=backend/uploads/inspections

# ── Email / SMTP configuration ────────────────────────────────────────────────
# Both EMAIL_* and SMTP_* variable names are supported for compatibility.
#
# Gmail setup (recommended for quick start):
#   1. Enable 2-Step Verification at https://myaccount.google.com/security
#   2. Generate an App Password at https://myaccount.google.com/apppasswords
#   3. Paste the 16-character App Password below (no spaces)
#
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_FROM="FabriSense Security" <your-email@gmail.com>

# Alternative SMTP_* variable names also accepted:
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# ── Supabase Cloud Configuration (PostgreSQL, Auth, Storage, Realtime) ──────
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=inspection-images

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (Vite) — VITE_ prefix required for browser access
# ─────────────────────────────────────────────────────────────────────────────
# Controls which backend URL the frontend calls.
#
# ┌──────────────────────────────┬────────────────────────────────────────────┐
# │ Scenario                     │ Value                                      │
# ├──────────────────────────────┼────────────────────────────────────────────┤
# │ Browser dev (npm run dev)    │ (leave empty) — Vite proxy handles /api    │
# │ Android Emulator             │ http://10.0.2.2:5000                       │
# │ Android device (LAN)         │ http://192.168.x.x:5000  (your LAN IP)    │
# │ Production / deployed server │ https://api.yourdomain.com                 │
# └──────────────────────────────┴────────────────────────────────────────────┘
#
VITE_API_BASE_URL=

# Frontend Supabase Client (Anon Key only — never expose service-role key to frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_STORAGE_BUCKET=inspection-images

